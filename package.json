{
  "name": "mett-global-social",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.mjs",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "build:vercel": "node scripts/build-vercel.mjs",
    "build:preview": "node scripts/build-preview.mjs",
    "preview": "vite preview --outDir dist-preview --host 127.0.0.1 --port 4173 --strictPort",
    "test:preview": "playwright test -c playwright.preview.config.ts"
    ,"desktop": "electron .",
    "build:desktop": "node scripts/build-desktop.mjs",
    "test:desktop": "node scripts/test-desktop.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3",
    "prettier": "^3.9.10",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
