{
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|assets/|icon.svg|icon-192.png|icon-512.png|manifest.webmanifest|sw.js).*)",
      "destination": "/index.html"
    }
  ]
}
